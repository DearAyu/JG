{
  "name": "jg",
  "version": "0.1.0",
  "description": "JG - A SillyTavern-style AI character chat application",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron electron/storage-setup.cjs && concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:electron": "wait-on http-get://127.0.0.1:5173/api/health && nodemon",
    "desktop:dev": "electron electron/storage-setup.cjs && concurrently -k -n client,server,electron -c blue,green,magenta \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:electron\"",
    "build": "npm run build -w client && npm run build -w server",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win",
    "start": "npm run start -w server",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write \"**/*.{ts,vue,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "wait-on": "^9.1.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "@primno/dpapi": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^4.22.2"
  },
  "nodemonConfig": {
    "watch": [
      "electron"
    ],
    "ext": "cjs,js,json",
    "exec": "node electron/dev-electron.cjs",
    "signal": "SIGTERM",
    "delay": 1500
  },
  "build": {
    "appId": "com.jg.desktop",
    "productName": "JG",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*",
      "package.json",
      "!server/dist/**/*.map",
      "!server/dist/**/*.d.ts"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "JG-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "JG-Portable-${version}-${arch}.${ext}"
    }
  }
}
